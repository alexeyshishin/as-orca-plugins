{
  "$schema": "https://raw.githubusercontent.com/stablyai/orca/main/docs/schemas/plugins/orca-plugin.v2.schema.json",
  "manifestVersion": 2,
  "id": "git-gutter",
  "name": "Git Gutter",
  "version": "0.1.0",
  "description": "Marks added, modified and deleted lines in a colored gutter next to the line numbers, based on git diff.",
  "author": {
    "name": "alexeyshishin",
    "url": "https://github.com/alexeyshishin"
  },
  "repository": "https://github.com/alexeyshishin/as-orca-plugins",
  "license": "MIT",
  "icon": "assets/icon.png",
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "worker/main.mjs",
  "capabilities": [{ "kind": "workspace:read" }],
  "engines": {
    "orca": ">=1.4.248"
  },
  "contributes": {
    "customEditors": [
      {
        "id": "gutter-editor",
        "title": "Git Gutter",
        "extensions": [".js", ".mjs", ".ts", ".json"],
        "entry": "editor/index.html",
        "priority": "option",
        "contentKind": "text"
      }
    ]
  }
}
